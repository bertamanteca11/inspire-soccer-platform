{
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "demo": "node scripts/preview-demo.cjs",
    "demo:check": "node scripts/preview-demo.cjs --check",
    "release:sql": "node scripts/prepare-release-sql.cjs",
    "test": "node --test tests/phase1.test.cjs tests/phase4.test.cjs tests/session-archive.test.cjs tests/evaluation-correctness.test.cjs tests/batch4.test.cjs tests/batch4-database.test.cjs tests/final-quality.test.cjs tests/release-database.test.cjs tests/release-quality.test.cjs tests/veo.test.cjs tests/veo-analytics.test.cjs tests/veo-database.test.cjs",
    "build:check": "tsc --noEmit --incremental false && vite build --outDir .veo-build-check --emptyOutDir false",
    "test:veo-ui": "playwright test -c tests/veo.playwright.config.cjs",
    "test:phase4-ui": "playwright test -c tests/phase4.playwright.config.cjs",
    "test:design-ui": "playwright test -c tests/design-system.playwright.config.cjs",
    "test:shell-ui": "playwright test -c tests/shell.playwright.config.cjs",
    "test:batch4": "node --test tests/batch4.test.cjs tests/batch4-database.test.cjs",
    "test:batch4-ui": "playwright test -c tests/batch4.playwright.config.cjs",
    "test:final-ui": "playwright test -c tests/final.playwright.config.cjs",
    "test:typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@vitejs/plugin-react": "^4.3.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "typescript": "^5.6.2",
    "vite": "6.4.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1"
  }
}
