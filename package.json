{
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/phase1.test.cjs tests/phase4.test.cjs tests/session-archive.test.cjs tests/evaluation-correctness.test.cjs tests/veo.test.cjs tests/veo-analytics.test.cjs tests/veo-database.test.cjs",
